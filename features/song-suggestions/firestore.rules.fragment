// Insert inside match /databases/{database}/documents in CURRENT production rules.
// Do not replace the current rules with this fragment.
match /songSuggestions/{suggestionId} {
  function activeSuggestionMember() {
    return request.auth != null
      && request.auth.token.email_verified == true
      && exists(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email.lower()))
      && get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email.lower())).data.get('status', 'active') != 'inactive';
  }
  function suggestionAdmin() {
    return activeSuggestionMember()
      && get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email.lower())).data.role == 'admin';
  }
  allow read: if activeSuggestionMember()
    && (suggestionAdmin() || resource.data.user_uid == request.auth.uid);
  allow create: if activeSuggestionMember()
    && request.resource.data.keys().hasAll(['title','artist','note','user_uid','user_email','user_name','createdAt'])
    && request.resource.data.keys().hasOnly(['title','artist','note','user_uid','user_email','user_name','createdAt'])
    && request.resource.data.user_uid == request.auth.uid
    && request.resource.data.user_email == request.auth.token.email.lower()
    && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 160
    && request.resource.data.artist is string && request.resource.data.artist.size() > 0 && request.resource.data.artist.size() <= 160
    && request.resource.data.note is string && request.resource.data.note.size() <= 1000
    && request.resource.data.user_name is string && request.resource.data.user_name.size() <= 160
    && request.resource.data.createdAt == request.time;
  allow update, delete: if false;
}
